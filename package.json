{
  "name": "copc01-eportfolio",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "ASTRO_TELEMETRY_DISABLED=1 astro dev",
    "build": "ASTRO_TELEMETRY_DISABLED=1 astro check && ASTRO_TELEMETRY_DISABLED=1 astro build",
    "preview": "ASTRO_TELEMETRY_DISABLED=1 astro preview",
    "serve:dist": "node scripts/serve-dist.mjs",
    "serve:test": "npm run build && npm run serve:dist",
    "check": "ASTRO_TELEMETRY_DISABLED=1 astro check",
    "test": "vitest run",
    "test:e2e": "PLAYWRIGHT_BROWSERS_PATH=/tmp/copc01-playwright playwright test",
    "resume:pdf": "PLAYWRIGHT_BROWSERS_PATH=/tmp/copc01-playwright node scripts/render-resume.mjs"
  },
  "dependencies": {
    "@astrojs/sitemap": "^3.7.3",
    "astro": "^7.2.2"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.10",
    "@axe-core/playwright": "^4.13.0",
    "@playwright/test": "^1.62.1",
    "typescript": "^5.9.2",
    "vitest": "^3.2.4"
  }
}
