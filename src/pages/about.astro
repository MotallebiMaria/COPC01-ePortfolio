---
import BaseLayout from "@/layouts/BaseLayout.astro";
const base = import.meta.env.BASE_URL;
---
<BaseLayout title="About — Maria Motallebi" description="About Maria Motallebi: computer science student, software engineer, teaching assistant, researcher, and technical leader.">
  <section class="about-hero page-shell">
    <div class="portrait-placeholder media-placeholder" role="img" aria-label="Placeholder for an optional professional portrait"><span>Optional portrait / 4:5 crop</span></div>
    <div>
      <p class="eyebrow">About</p>
      <h1 class="display">I like work that crosses boundaries.</h1>
      <p class="lede">Between software and hardware. Implementation and explanation. Independent investigation and shared understanding.</p>
    </div>
  </section>

  <section class="about-body page-shell reveal">
    <div class="about-label meta">Profile / 2026</div>
    <div class="prose">
      <p>I’m a Computer Science Specialist Co-op student in the Software Engineering Stream at the University of Toronto Scarborough. My experience spans backend development, embedded firmware, full-stack systems, computing-education research, university teaching, and student technical leadership.</p>
      <p>I’m currently completing my first co-op work term as a backend software developer at Rocket Innovation Studio. In Fall 2026, I will join Kepler Communications as an Embedded Software Engineering Intern. Alongside professional work, I serve as VP of Technology for UofT CREATE and have taught data structures, systems programming, and discrete mathematics as an undergraduate teaching assistant.</p>
      <p>I’m especially interested in systems where technical correctness has to meet real constraints: unfamiliar codebases, hardware interfaces, deployment environments, security boundaries, or the challenge of explaining an idea clearly enough that someone else can use it.</p>
      <div class="about-actions">
        <a class="button-link blue" href={`${base}resume/`}>Read résumé <span>→</span></a>
        <a class="button-link" href="mailto:motallebimaria@gmail.com">Send an email <span>↗</span></a>
      </div>
    </div>
  </section>

  <section class="interests surface reveal">
    <div class="page-shell">
      <p class="eyebrow">Current interests</p>
      <ul>
        <li>Software engineering</li><li>Systems programming</li><li>C and C++</li><li>Embedded systems</li><li>Computer engineering</li><li>Robotics</li><li>Theoretical computer science</li><li>Teaching</li><li>Research</li>
      </ul>
    </div>
  </section>
</BaseLayout>

<style>
  .about-hero { display: grid; grid-template-columns: .65fr 1.35fr; gap: clamp(2rem, 7vw, 7rem); align-items: end; padding-block: clamp(4rem, 8vw, 8rem); }
  .portrait-placeholder { aspect-ratio: 4/5; min-height: 0; }
  .about-hero .display { max-width: 12ch; margin-block: 1rem 2.5rem; font-size: clamp(3rem, 7vw, 7rem); }
  .about-body { display: grid; grid-template-columns: .65fr 1.35fr; gap: clamp(2rem, 7vw, 7rem); padding-block: var(--section); border-top: 1px solid var(--ink); }
  .prose { max-width: 50rem; }
  .prose > p { margin: 0 0 1.5rem; font-size: clamp(1.15rem, 2vw, 1.55rem); line-height: 1.5; letter-spacing: -.02em; }
  .about-actions { display: flex; flex-wrap: wrap; gap: 2rem; margin-top: 3rem; }
  .interests { padding-block: var(--section); border-top: 1px solid var(--rule); }
  .interests ul { display: flex; flex-wrap: wrap; margin: 3rem 0 0; padding: 0; border-top: 1px solid var(--ink); list-style: none; }
  .interests li { width: 33.333%; padding: 1rem 0; border-bottom: 1px solid var(--rule); font-size: clamp(1rem, 2vw, 1.4rem); }
  @media (max-width: 760px) { .about-hero, .about-body { grid-template-columns: 1fr; } .portrait-placeholder { max-width: 24rem; } .interests li { width: 50%; } }
</style>
